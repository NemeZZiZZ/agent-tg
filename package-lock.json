{
  "name": "agent-tg-repo",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "agent-tg-repo",
      "version": "0.1.0",
      "license": "MIT",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=18"
      }
    },
    "node_modules/agent-tg": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/claude-code-tg": {
      "resolved": "packages/claude-code",
      "link": true
    },
    "node_modules/opencode-tg": {
      "resolved": "packages/opencode",
      "link": true
    },
    "packages/claude-code": {
      "name": "claude-code-tg",
      "version": "0.1.0",
      "license": "MIT",
      "dependencies": {
        "agent-tg": "*"
      },
      "engines": {
        "node": ">=18"
      }
    },
    "packages/core": {
      "name": "agent-tg",
      "version": "0.1.0",
      "license": "MIT",
      "bin": {
        "agent-tg": "bin/agent-tg.mjs"
      },
      "engines": {
        "node": ">=18"
      }
    },
    "packages/opencode": {
      "name": "opencode-tg",
      "version": "0.1.0",
      "license": "MIT",
      "dependencies": {
        "agent-tg": "*"
      },
      "engines": {
        "node": ">=18"
      }
    }
  }
}
